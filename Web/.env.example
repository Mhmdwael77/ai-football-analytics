# ==============================================================================
# Trakora AI Football Analytics - Environment Configuration
# ==============================================================================

# Server Network Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Supabase Credentials (Storage & Database)
# In production, replace with your live Supabase project URL and keys.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=match-videos

# Upstash Redis / Local Redis (Caching & Job Orchestration)
# For local development with Docker Compose, point to localhost:6379 without password.
# For production Upstash Redis, supply rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenTelemetry Telemetry Endpoints
OTEL_SERVICE_NAME=trakora-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_EXPORTER_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_LOG_LEVEL=info

# Frontend Client Public Variables (Vite prefixes with VITE_)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
